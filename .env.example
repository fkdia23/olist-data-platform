# .env.example
# Copie ce fichier en .env puis change les mots de passe. Le .env n'est JAMAIS versionné.
# Pas de commentaire en fin de ligne : make les inclurait dans la valeur.

# Profils démarrés par make up : core suffit. Les autres ont leur cible (voir docker-compose.yml) :
# make lineage-up, make obs-up, make pilotage-up. Tout d'un coup : core,lineage,observability,pilotage
COMPOSE_PROFILES=core

# Images épinglées
PG13_IMAGE=postgres:13.23
PG16_IMAGE=postgres:16.15
MARQUEZ_VERSION=0.51.1
PROMETHEUS_VERSION=v3.16.0
CADVISOR_VERSION=v0.55.1
PG_EXPORTER_VERSION=v0.20.1
GRAFANA_VERSION=13.3.1
MAILPIT_VERSION=v1.33.1

# Source simulée (PostgreSQL 13), port publié sur ta machine : 5433
SOURCE_DB=olist_source
SOURCE_USER=source
SOURCE_PASSWORD=change_me_source
SOURCE_PORT=5433

# Entrepôt (PostgreSQL 16), port publié sur ta machine : 5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=change_me_warehouse
WAREHOUSE_PORT=5432

# Adresses utilisées par les commandes lancées depuis VS Code (hors Docker) : localhost
SOURCE_DSN=postgresql://source:change_me_source@localhost:5433/olist_source
WAREHOUSE_DSN=postgresql://warehouse:change_me_warehouse@localhost:5432/warehouse
SOURCE_API_URL=http://localhost:8000

# Générateur et pannes simulées
SCALE=1
CHAOS_RATE=0
DUCKDB_PATH=data/duckdb/mart.duckdb

# Traçabilité (profil lineage) : Marquez range ses tables dans la base marquez du pg16
MARQUEZ_DB_PASSWORD=change_me_marquez
# Ports publiés sur ta machine ; sur macOS, 5000 est pris par AirPlay : mets 5050
MARQUEZ_API_PORT=5000
MARQUEZ_WEB_PORT=3000
# dbt-ol lancé sur ta machine : localhost, et le même port que MARQUEZ_API_PORT
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=olist

# Surveillance (profil observability) : rôles créés par make obs-roles
GRAFANA_ADMIN_PASSWORD=change_me_grafana
PG16_GRAFANA_PASSWORD=change_me_grafana_ro
PG16_MONITOR_PASSWORD=change_me_monitor
PG13_MONITOR_PASSWORD=change_me_monitor
PG16_STREAMLIT_PASSWORD=change_me_streamlit

# Streamlit et le runner lancés sur ta machine ; dans Docker, le compose les réécrit avec pg16
PG16_STREAMLIT_URL=postgresql://warehouse:change_me_warehouse@localhost:5432/warehouse
PG16_RUNNER_URL=postgresql://warehouse:change_me_warehouse@localhost:5432/warehouse
